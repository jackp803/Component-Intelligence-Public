<UserControl x:Class="ComponentIntelligence.Desktop.DrawingPlanningWorkspaceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="520" MinWidth="900">
  <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
      <Button Content="Generate Preview" Margin="0,0,6,0" Padding="10,5" Click="GeneratePreviewGate_Click"/>
      <Button Content="Generate AutoCAD Electrical" Margin="0,0,6,0" Padding="10,5" Click="GenerateAutoCadGate_Click" ToolTip="CP3-C writes only to ISOLATED_STAGING. APPLIED is not VERIFIED."/>
      <Button Content="Runtime Settings" Margin="0,0,6,0" Padding="10,5" Click="ConfigureRuntime_Click"/>
      <Button x:Name="OpenOutputFolderButton" Content="Open Output Folder" IsEnabled="False" Margin="0,0,6,0" Padding="10,5" Click="OpenOutputFolder_Click"/>
      <Button x:Name="OpenOutputProjectButton" Content="Open Project" IsEnabled="False" Margin="0,0,6,0" Padding="10,5" Click="OpenOutputProject_Click"/>
      <Button Content="Save Plan" Margin="0,0,6,0" Padding="10,5" Click="Save_Click"/>
      <Button Content="Undo" Margin="0,0,6,0" Padding="10,5" Click="Undo_Click"/>
      <Button Content="Redo" Margin="0,0,6,0" Padding="10,5" Click="Redo_Click"/>
      <Button Content="Align Left" Margin="0,0,6,0" Padding="10,5" Click="AlignLeft_Click"/>
      <Button Content="Distribute H" Margin="0,0,6,0" Padding="10,5" Click="DistributeHorizontal_Click"/>
      <Button Content="Reset Page Auto" Margin="0,0,6,0" Padding="10,5" Click="ResetPage_Click"/>
      <Button Content="History" Padding="10,5" Click="History_Click"/>
    </WrapPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock DockPanel.Dock="Top" Text="Pages (drag to reorder)" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ListBox x:Name="PageList" DisplayMemberPath="PageId" SelectionChanged="PageList_SelectionChanged"
                 AllowDrop="True" PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="PageList_PreviewMouseMove" Drop="PageList_Drop"/>
      </DockPanel>
      <Border Grid.Column="1" BorderBrush="#BBB" BorderThickness="1" Background="#FAFAFA" ClipToBounds="True">
        <ScrollViewer x:Name="DrawingScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="DrawingScroll_PreviewMouseWheel">
          <Canvas x:Name="DrawingCanvas" Width="1100" Height="760" Background="White" MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown"/>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2" Margin="8,0,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Selection" FontWeight="SemiBold"/>
        <ListBox x:Name="SelectionList" Grid.Row="1" Height="120" SelectionMode="Extended" SelectionChanged="SelectionList_SelectionChanged"/>
        <StackPanel Grid.Row="2"><TextBlock Text="Grid snap" Margin="0,8,0,2"/><TextBox x:Name="GridSnapText" Text="10"/></StackPanel>
        <StackPanel Grid.Row="3"><TextBlock Text="Route / Placement state" Margin="0,8,0,2"/><ComboBox x:Name="StateCombo" SelectedIndex="0"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Manual"/><ComboBoxItem Content="Locked"/></ComboBox></StackPanel>
        <WrapPanel Grid.Row="4" Margin="0,6,0,0"><Button Content="Apply State" Margin="0,0,6,0" Click="ApplyPlacementState_Click"/><Button Content="Rotate legal" Click="Rotate_Click"/></WrapPanel>
        <TextBlock Grid.Row="5" Text="Issues / Preflight" FontWeight="SemiBold" Margin="0,10,0,4"/>
        <ListBox x:Name="IssueList" Grid.Row="6" MouseDoubleClick="IssueList_MouseDoubleClick"/>
      </Grid>
    </Grid>
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8,0,0" Text="Drawing Plan not loaded." TextWrapping="Wrap"/>
  </Grid>
</UserControl>
