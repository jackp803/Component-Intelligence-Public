<Window x:Class="ComponentIntelligence.Desktop.ElectricalWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ComponentIntelligence.Desktop"
        Title="Component Intelligence - Electrical Design" Height="900" Width="1420"
        MinHeight="500" MinWidth="840" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="電氣設計" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
            <WrapPanel VerticalAlignment="Center">
                <ComboBox x:Name="ProjectIdText" Width="170" Height="30" IsEditable="True"
                          DisplayMemberPath="Display" SelectedValuePath="ProjectId"
                          VerticalContentAlignment="Center"
                          ToolTip="選擇已儲存專案，或貼上已知 Project ID，再按載入" />
                <TextBox x:Name="ProjectNameText" Width="210" Margin="6,0,0,0" Height="30" VerticalContentAlignment="Center" ToolTip="專案名稱"/>
                <Button Content="新專案" Padding="8,4" Margin="6,0,0,0" Click="NewProject_Click"/>
                <Button FontFamily="Segoe MDL2 Assets" Content="&#xE74E;" ToolTip="儲存專案 (Ctrl+S)" Padding="9,6" Margin="6,0,0,0" Click="SaveProject_Click"/>
                <Button Content="載入" Padding="8,4" Margin="6,0,0,0" Click="LoadProject_Click"/>
                <Button x:Name="UndoButton" FontFamily="Segoe MDL2 Assets" Content="&#xE7A7;" Padding="9,6" Margin="6,0,0,0" Click="Undo_Click"/>
                <Button x:Name="RedoButton" FontFamily="Segoe MDL2 Assets" Content="&#xE7A6;" Padding="9,6" Margin="6,0,0,0" Click="Redo_Click"/>
                <Button Content="同步中央庫" Padding="8,4" Margin="6,0,0,0" Click="SyncCentralArchive_Click" ToolTip="更新元件規格、Port/Pin 與圖片；保留數量、位置與接線"/>
                <Button x:Name="RetryWorkingBomButton" Content="重試起始 BOM" Visibility="Collapsed" Padding="8,4" Margin="6,0,0,0" Click="RetryWorkingBom_Click"/>
                <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8B7;" Padding="9,6" Margin="6,0,0,0" ToolTip="專案／中央庫資料位置" Click="DataPaths_Click"/>
                <Button Content="復原備份" Padding="8,4" Margin="6,0,0,0" Click="Recovery_Click"/>
                <TextBlock x:Name="SaveStateText" Text="尚未儲存" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#556266"/>
            </WrapPanel>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="2">
            <TabItem x:Name="SchematicTab" Header="工程圖" />
            <TabItem x:Name="TopologyTab" Header="拓樸 Topology">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="EngineeringReviewButton" Content="工程確認" Padding="14,5" Click="EngineeringReview_Click" />
                    </WrapPanel>
                    <local:TopologyCanvasControl x:Name="TopologyCanvas" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem x:Name="LayoutTab" Header="Layout｜實體佈局" />
            <TabItem x:Name="DrawingPlanningTab" Header="Drawing Planning｜圖面規劃" />
        </TabControl>

        <TextBlock Grid.Row="3" x:Name="WorkspaceStatusText" Text="Electrical Project 尚未儲存" Foreground="#666" Margin="0,10,0,0" />
    </Grid>
</Window>
