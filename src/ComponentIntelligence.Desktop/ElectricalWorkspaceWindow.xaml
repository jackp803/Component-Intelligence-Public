<Window x:Class="ComponentIntelligence.Desktop.ElectricalWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ComponentIntelligence.Desktop"
        Title="Component Intelligence - Electrical Design" Height="900" Width="1420"
        MinHeight="740" MinWidth="1140" WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Electrical Design Engine｜電氣設計引擎" FontSize="26" FontWeight="SemiBold" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12" Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Project ID" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ProjectIdText" Grid.Column="1" Height="30" IsEditable="True"
                          DisplayMemberPath="Display" SelectedValuePath="ProjectId"
                          VerticalContentAlignment="Center"
                          ToolTip="選擇已儲存專案，或貼上已知 Project ID，再按載入" />
                <TextBlock Grid.Column="2" Text="名稱" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox x:Name="ProjectNameText" Grid.Column="3" Height="30" VerticalContentAlignment="Center" />
                <Button Grid.Column="4" Content="新專案" Padding="12,6" Margin="10,0,0,0" Click="NewProject_Click" />
                <Button Grid.Column="5" Content="儲存" Padding="12,6" Margin="6,0,0,0" Click="SaveProject_Click" />
                <Button Grid.Column="6" Content="載入" Padding="12,6" Margin="6,0,0,0" Click="LoadProject_Click" />
                <Button x:Name="UndoButton" Grid.Column="7" Content="復原 Undo" Padding="12,6" Margin="10,0,0,0" Click="Undo_Click" />
                <Button x:Name="RedoButton" Grid.Column="8" Content="重做 Redo" Padding="12,6" Margin="6,0,0,0" Click="Redo_Click" />
                <Button Grid.Column="9" Content="同步中央庫" Padding="14,6" Margin="8,0,0,0" HorizontalAlignment="Right" Click="SyncCentralArchive_Click" ToolTip="更新元件規格、尺寸、Port/Pin 與圖片；保留數量、位置、旋轉及接線" />
            </Grid>
        </Border>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="2">
            <TabItem x:Name="TopologyTab" Header="拓樸 Topology">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="EngineeringReviewButton" Content="工程確認" Padding="14,5" Click="EngineeringReview_Click" />
                    </WrapPanel>
                    <local:TopologyCanvasControl x:Name="TopologyCanvas" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem x:Name="LayoutTab" Header="Layout｜實體佈局" />
            <TabItem x:Name="DrawingPlanningTab" Header="Drawing Planning｜圖面規劃" />
        </TabControl>

        <TextBlock Grid.Row="3" x:Name="WorkspaceStatusText" Text="Electrical Project 尚未儲存" Foreground="#666" Margin="0,10,0,0" />
    </Grid>
</Window>
