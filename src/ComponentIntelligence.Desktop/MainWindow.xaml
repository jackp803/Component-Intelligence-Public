<Window x:Class="ComponentIntelligence.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Component Intelligence" Height="820" Width="1260"
        MinHeight="680" MinWidth="1060" WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_NotionOnlyLoaded">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Component Intelligence" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Text="BOM → Notion 中央庫 → 缺欄位清單 → 人工找原廠 PDF → GPT 更新 Notion → 電氣設計" Margin="0,4,0,0" Foreground="#666" />
            </StackPanel>
            <Button x:Name="LanguageButton" Grid.Column="1" Content="English" Padding="14,7" VerticalAlignment="Top" Click="ToggleNotionLanguage_Click" ToolTip="切換中文 / English" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ImportBomButton" Content="匯入 BOM" Padding="18,9" Margin="0,0,8,0" Click="ImportBom_Click" />
            <Button x:Name="TemplateButton" Grid.Column="1" Content="產生 BOM 範本" Padding="18,9" Margin="0,0,8,0" Click="GenerateTemplate_Click" />
            <Button x:Name="ProcessButton" Grid.Column="2" Content="從 Notion 取得" Padding="18,9" Margin="0,0,8,0" Click="ProcessNotion_Click" />
            <Button x:Name="ElectricalButton" Grid.Column="3" Content="電氣設計" Padding="18,9" Margin="0,0,8,0" Click="OpenElectricalWorkspace_Click" />
            <Button x:Name="TopologyButton" Grid.Column="4" Content="電路拓樸" Padding="18,9" Margin="0,0,8,0" Click="OpenTopology_Click" ToolTip="直接開啟 Electrical Topology（電氣拓樸）頁面" />
            <Button x:Name="NotionButton" Grid.Column="5" Content="Notion 中央庫" Padding="18,9" Click="OpenNotionConnection_Click" ToolTip="設定 Notion Integration Token、測試連線並儲存中央電料庫連線" />
            <TextBlock Grid.Column="6" x:Name="StatusText" Text="尚未匯入 BOM" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#555" Margin="12,0,0,0" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14" Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SearchHeaderText" Text="Notion 元件查詢" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox x:Name="SearchManufacturerText" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Manufacturer，例如 IFM、WAGO、OMRON" />
                <TextBlock x:Name="ModelLabelText" Grid.Column="2" Text="型號" VerticalAlignment="Center" Margin="4,0,8,0" />
                <TextBox x:Name="SearchModelText" Grid.Column="3" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" ToolTip="Model / Part Number" />
                <Button x:Name="SearchButton" Grid.Column="4" Content="查 Notion" Padding="14,6" Margin="0,0,6,0" Click="SearchNotionComponent_Click" />
                <Button x:Name="DeepSearchButton" Grid.Column="5" Content="深度搜尋 / Deep Search" Padding="12,6" Margin="0,0,6,0" Click="DeepSearchComponent_Click" Visibility="Collapsed" IsTabStop="False" />
                <Button x:Name="AddSearchResultButton" Grid.Column="6" Content="加入 BOM" Padding="14,6" IsEnabled="False" Click="AddSearchResultToBom_Click" ToolTip="Notion 查詢只預覽；按這裡才加入目前 BOM" />
                <TextBlock x:Name="SearchHintText" Grid.Column="7" Text="只讀 Notion；缺欄位交給人工找原廠 PDF，再由 GPT 更新 Notion" Foreground="#777" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6">
                <DataGrid x:Name="BomGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          SelectionChanged="BomGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ManufacturerColumn" Header="製造商" Binding="{Binding Manufacturer}" Width="*" />
                        <DataGridTextColumn x:Name="ModelColumn" Header="型號 / 料號" Binding="{Binding Model}" Width="1.4*" />
                        <DataGridTextColumn x:Name="UsedColumn" Header="使用" Binding="{Binding UsedQuantity}" Width="0.7*" />
                        <DataGridTextColumn x:Name="TotalColumn" Header="總數" Binding="{Binding TotalQuantity}" Width="0.7*" />
                        <DataGridTextColumn x:Name="SpareColumn" Header="備品" Binding="{Binding SpareQuantity}" Width="0.7*" />
                        <DataGridTextColumn x:Name="StatusColumn" Header="狀態" Binding="{Binding Status}" Width="1.4*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetailsHeaderText" Text="Notion 元件資料與缺欄位" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="ShowKnowledgeButton" Grid.Column="1" Content="知識明細 / Knowledge" Padding="12,5" Margin="0,0,8,0"
                                Click="ShowKnowledgeDetails_Click"
                                ToolTip="顯示目前保存的全部規格、文件與證據來源" />
                        <Button x:Name="CompareSourcesButton" Grid.Column="2" Content="來源比較 / Sources" Padding="12,5" Margin="0,0,8,0"
                                Click="CompareSources_Click"
                                ToolTip="比較同一工程欄位在 Notion 中保存的來源與值" />
                        <Button x:Name="AddKnowledgeFileButton" Grid.Column="3" Content="補充資料 / Add File" Padding="12,5"
                                Click="AddKnowledgeFile_Click" Visibility="Collapsed" IsTabStop="False" />
                    </Grid>
                    <TextBox x:Name="DetailsText" Grid.Row="1"
                             Text="選取一筆 BOM 資料，或使用上方 Notion 元件查詢。"
                             IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             ToolTip="可複製缺欄位清單，連同人工找到的原廠 PDF 一起交給 GPT 更新 Notion" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DatabaseLabelText" Text="SQLite 執行快取：" Foreground="#666" />
            <TextBlock Grid.Column="1" x:Name="DatabasePathText" Foreground="#666" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
