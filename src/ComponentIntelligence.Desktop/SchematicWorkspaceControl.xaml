<UserControl x:Class="ComponentIntelligence.Desktop.SchematicWorkspaceControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="True" PreviewKeyDown="OnKeyDown">
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <WrapPanel Margin="0,0,0,8">
   <ToggleButton x:Name="SelectTool" Content="選取" IsChecked="True" Padding="12,5" Click="Select_Click" ToolTip="選取 (V)"/>
   <ToggleButton x:Name="WireTool" Content="導線" Padding="12,5" Margin="4,0" Click="Wire_Click" ToolTip="導線 (W)"/>
   <Button Content="完成線段" Padding="12,5" Click="FinishWire_Click" ToolTip="完成線段 (Enter／雙擊)"/>
   <Button Content="跨頁符號" Padding="12,5" Margin="4,0" Click="Continuation_Click" ToolTip="跨頁符號 (X)"/>
   <Button Content="接點設定" Padding="12,5" Click="Bindings_Click" ToolTip="接點設定 (B)"/>
   <Button Content="圖塊外觀" Padding="12,5" Margin="4,0" Click="ImportSymbol_Click" ToolTip="圖塊外觀 (I)"/>
   <Button Content="圖框／頁面" Padding="12,5" Click="ImportTemplate_Click" ToolTip="圖框／頁面 (T)"/>
   <Button FontFamily="Segoe MDL2 Assets" Content="&#xE7AD;" ToolTip="旋轉 90 度 (R)" Padding="10,5" Margin="4,0" Click="Rotate_Click"/>
   <Button FontFamily="Segoe MDL2 Assets" Content="&#xE72E;" ToolTip="鎖定／解鎖 (L)" Padding="10,5" Click="Lock_Click"/>
   <Button Content="前往對端" Padding="12,5" Margin="4,0" Click="Navigate_Click" ToolTip="前往對端 (J)"/>
   <Button Content="搬到其他頁" Padding="12,5" Click="MoveSymbolPage_Click" ToolTip="搬到其他頁 (Ctrl+M)"/>
   <Button Content="線材設定" Padding="12,5" Margin="4,0" Click="CableSettings_Click" ToolTip="線材設定 (C)"/>
   <Button Content="線材庫" Padding="12,5" Margin="4,0" Click="CableLibrary_Click" ToolTip="新增一條實體線材 (Ctrl+Shift+C)"/>
   <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8A5;" Padding="10,5" Click="CableDetail_Click" ToolTip="線材明細 (Ctrl+D)"/>
   <Button Content="AWG" Padding="12,5" Click="Gauge_Click" ToolTip="導線規格 (G)"/>
   <Button Content="?" Padding="12,5" Click="Shortcuts_Click" ToolTip="快捷鍵 (F1)"/>
   <Button Content="草稿缺口" Padding="12,5" Click="ReviewDraft_Click" ToolTip="查看草稿缺口 (F8)"/>
   <ToggleButton x:Name="AllPagesTool" Content="所有頁面" Padding="12,5" Click="AllPages_Click" ToolTip="單頁／所有頁面 (F6)"/>
   <Button Content="DXF 草稿" Padding="12,5" Click="ExportDraft_Click" ToolTip="匯出 DXF 草稿 (Ctrl+E)"/>
   <Button Content="PDF 草稿" Padding="12,5" Click="ExportPdf_Click" ToolTip="儲存並匯出多頁 PDF 草稿 (Ctrl+Shift+E)"/>
   <Button FontFamily="Segoe MDL2 Assets" Content="&#xE749;" Padding="10,5" Click="Print_Click" ToolTip="儲存並列印草稿 (Ctrl+P)"/>
   <Slider x:Name="Zoom" Minimum="0.25" Maximum="2" Value="0.65" Width="110" Margin="12,0" ToolTip="縮放" ValueChanged="Zoom_Changed"/>
  </WrapPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,8,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,5">
     <TextBlock Text="頁面" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="＋" ToolTip="新增頁面 (Ctrl+Shift+N)" Width="30" Click="AddPage_Click"/>
      <Button Content="↑" ToolTip="頁面往前 (Alt+PageUp)" Width="30" Click="PageUp_Click"/>
      <Button Content="↓" ToolTip="頁面往後 (Alt+PageDown)" Width="30" Click="PageDown_Click"/>
     </StackPanel>
    </DockPanel>
    <ListBox x:Name="PageList" Grid.Row="1" DisplayMemberPath="Label" SelectionChanged="Page_Selected">
     <ListBox.ContextMenu><ContextMenu><MenuItem Header="重新命名目前頁面" InputGestureText="F2" Click="RenamePage_Click"/></ContextMenu></ListBox.ContextMenu>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,12,0,5">
     <TextBlock Text="資料中心元件" FontWeight="SemiBold"/>
     <TextBox x:Name="Search" Margin="0,5,0,0" TextChanged="Search_Changed" ToolTip="搜尋廠牌、型號 (Ctrl+F)"/>
    </StackPanel>
    <ListBox x:Name="CatalogList" Grid.Row="3" DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    <Button Grid.Row="4" Content="放置元件" Padding="10,6" Margin="0,5,0,0" Click="Place_Click" ToolTip="放置元件 (P)；取消 (Esc)"/>
   </Grid>
   <Border Grid.Column="1" BorderBrush="#CBD0D2" BorderThickness="1" Background="#E9ECEC">
    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="PageHost" HorizontalAlignment="Left">
      <StackPanel.LayoutTransform><ScaleTransform x:Name="SheetZoom" ScaleX="0.65" ScaleY="0.65"/></StackPanel.LayoutTransform>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <StackPanel Grid.Column="2" Margin="10,0,0,0">
    <TextBlock Text="選取項目" FontWeight="SemiBold"/>
    <TextBlock x:Name="SelectionLabel" TextWrapping="Wrap" Margin="0,8,0,12"/>
    <TextBlock Text="Reference"/>
    <TextBox x:Name="ReferenceText" Margin="0,4,0,6"/>
    <Button Content="套用 Reference" Padding="8,5" Click="Reference_Click" ToolTip="套用 Reference (Ctrl+Enter)"/>
    <Button Content="放置另一個表示" Padding="8,5" Margin="0,6,0,0" Click="AnotherRepresentation_Click" ToolTip="放置此元件的另一個表示 (Shift+P)"/>
    <TextBlock x:Name="SelectionState" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#61696B"/>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#41494B"/>
 </Grid>
</UserControl>
