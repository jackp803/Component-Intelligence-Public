<UserControl x:Class="ComponentIntelligence.Desktop.TopologyCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="420" MinWidth="700"
             Focusable="True"
             Loaded="TopologyCanvas_Loaded"
             PreviewMouseLeftButtonDown="TopologyCanvas_PreviewMouseLeftButtonDown"
             PreviewMouseRightButtonDown="TopologyCanvas_PreviewMouseRightButtonDown"
             PreviewKeyDown="TopologyCanvas_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6" Padding="8" Background="#FAFAFA" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="SelectModeButton" Content="選取 / Select" Padding="12,5" Margin="0,0,6,0" Click="SelectMode_Click" />
                    <Button x:Name="WireModeButton" Content="拉線 / Wire" Padding="12,5" Margin="0,0,6,0" Click="WireMode_Click" ToolTip="左鍵點第一個 Port 或端子圓點，再移動到第二個端點左鍵完成；Esc / 右鍵取消" />
                    <Button Content="自動排版 / Auto Layout" Padding="12,5" Margin="0,0,6,0" Click="AutoRouteConnections_Click" ToolTip="依接線關係重新排列畫布上的元件，再計算全部 90° 配線通道；可使用 Undo 復原" />
                    <Button Content="匯出 PDF" Padding="12,5" Margin="0,0,6,0" Click="ExportPdf_Click" ToolTip="把目前可見的拓樸畫布匯出為 PDF" />
                    <Button Content="? 操作說明" Padding="12,5" Click="ShowHelp_Click" />
                </StackPanel>
                <TextBlock x:Name="SelectionText" Text="未選取" VerticalAlignment="Center" Foreground="#666" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border x:Name="HintBanner" Grid.Row="1" BorderBrush="#B9D7F2" BorderThickness="1" CornerRadius="5" Background="#EEF7FF" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button Content="×" DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Click="DismissHint_Click" ToolTip="關閉提示" />
                <TextBlock x:Name="HintText" Text="操作提示：左側元件清單可以直接拖到畫布整理位置；畫布內元件也能拖曳。按「拉線」後點 A Endpoint 再點 B Endpoint 完成精確接線；正式線應固定吸附真正 Port/Pin 圓點並使用 90° 折線。" TextWrapping="Wrap" Foreground="#245A85" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA" Padding="8" Margin="0,0,6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="元件 / Components" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="這裡只顯示尚未放上畫布的 BOM／專案元件；拖到右側後會從清單消失，但不會刪除元件資料。" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox x:Name="TopologyPalette"
                             DisplayMemberPath="Display"
                             PreviewMouseLeftButtonDown="TopologyPalette_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TopologyPalette_PreviewMouseMove"
                             HorizontalContentAlignment="Stretch" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E5E5E5" ShowsPreview="True" />

            <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Background="#F7F7F7">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="Surface" Width="3200" Height="2000" Background="White" AllowDrop="True"
                            DragOver="Surface_TopologyPaletteDragOver"
                            Drop="Surface_TopologyPaletteDrop"
                            MouseMove="Surface_WirePreviewMouseMove" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
