<UserControl x:Class="ComponentIntelligence.Desktop.TopologyCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="420" MinWidth="700"
             Focusable="True"
             Loaded="TopologyCanvas_Loaded"
             PreviewMouseLeftButtonDown="TopologyCanvas_PreviewMouseLeftButtonDown"
             PreviewMouseRightButtonDown="TopologyCanvas_PreviewMouseRightButtonDown"
             PreviewKeyDown="TopologyCanvas_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6" Padding="8" Background="#FAFAFA" Margin="0,0,0,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="SelectModeButton" Content="選取 / Select" Padding="12,5" Margin="0,0,6,0" Click="SelectMode_Click" />
                    <Button x:Name="WireModeButton" Content="拉線 / Wire" Padding="12,5" Margin="0,0,6,0" Click="WireMode_Click" ToolTip="左鍵點第一個 Port 或端子圓點，再移動到第二個端點左鍵完成；Esc / 右鍵取消" />
                    <Button Content="自製 Cable / Harness" Padding="12,5" Margin="0,0,6,0" Click="CreateCustomHarness_Click" ToolTip="先新增並展開接頭 Pin、自己完成接線，再點接頭按此按鈕。程式只會依實際 Pin 連線整理 Cable，不會改接或合併其他分支" />
                    <Button Content="自動排版 / Auto Layout" Padding="12,5" Margin="0,0,6,0" Click="AutoRouteConnections_Click" ToolTip="依接線關係重新排列畫布上的元件，再計算全部 90° 配線通道；可使用 Undo 復原" />
                    <Button Content="匯出 PDF" Padding="12,5" Margin="0,0,6,0" Click="ExportPdf_Click" ToolTip="忠實匯出完整拓撲畫布；先選取線材，可在 PDF 保留加粗高亮效果" />
                    <Button Content="? 操作說明" Padding="12,5" Click="ShowHelp_Click" />
                </StackPanel>
                <TextBlock x:Name="SelectionText" Text="未選取" VerticalAlignment="Center" Foreground="#666" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border x:Name="HintBanner" Grid.Row="1" BorderBrush="#B9D7F2" BorderThickness="1" CornerRadius="5" Background="#EEF7FF" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button Content="×" DockPanel.Dock="Right" Width="26" Height="24" Padding="0" Click="DismissHint_Click" ToolTip="關閉提示" />
                <TextBlock x:Name="HintText" Text="操作提示：框選後按 Del 可刪線，並將一般元件移回左側清單；端子台會保留。Ctrl + 滑鼠滾輪可縮放。" TextWrapping="Wrap" Foreground="#245A85" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Background="#FAFAFA" Padding="8" Margin="0,0,6,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="元件 / Components" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="下方顯示尚未放上畫布的專案元件。公用 Phoenix 端子台／短路片與常用接頭可從下拉選單按＋新增。" Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="Phoenix 端子台" FontWeight="SemiBold" Margin="0,8,0,3" />
                        <DockPanel>
                            <Button Content="＋" DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" Click="AddArchivedTerminal_Click" ToolTip="新增一個選定的公用端子台到 Topology 與 Layout" />
                            <ComboBox x:Name="TerminalArchiveCombo" DisplayMemberPath="Display" DropDownOpened="ArchiveMaterialCombo_DropDownOpened" />
                        </DockPanel>
                        <TextBlock x:Name="TerminalProjectCountText" Text="專案數量：0" Foreground="#666" Margin="0,2,0,0" />
                        <TextBlock Text="Phoenix 短路片" FontWeight="SemiBold" Margin="0,7,0,3" />
                        <DockPanel>
                            <Button Content="＋" DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" Click="AddArchivedJumper_Click" ToolTip="新增一個選定的公用短路片到 Topology 與 Layout" />
                            <ComboBox x:Name="JumperArchiveCombo" DisplayMemberPath="Display" DropDownOpened="ArchiveMaterialCombo_DropDownOpened" />
                        </DockPanel>
                        <TextBlock x:Name="JumperProjectCountText" Text="專案數量：0" Foreground="#666" Margin="0,2,0,0" />
                        <TextBlock Text="公用接頭 / Common Connector" FontWeight="SemiBold" Margin="0,7,0,3" />
                        <DockPanel>
                            <Button Content="＋" DockPanel.Dock="Right" Width="34" Margin="6,0,0,0" Click="AddCommonConnector_Click" ToolTip="新增一個選定的公用接頭到目前可見的 Topology 畫面" />
                            <ComboBox x:Name="CommonConnectorCombo" DisplayMemberPath="Display" IsTextSearchEnabled="True" MaxDropDownHeight="300" />
                        </DockPanel>
                        <TextBlock x:Name="CommonConnectorProjectCountText" Text="專案數量：0" Foreground="#666" Margin="0,2,0,0" />
                    </StackPanel>
                    <ListBox x:Name="TopologyPalette"
                             DisplayMemberPath="Display"
                             PreviewMouseLeftButtonDown="TopologyPalette_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="TopologyPalette_PreviewMouseMove"
                             HorizontalContentAlignment="Stretch" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E5E5E5" ShowsPreview="True" />

            <Border Grid.Column="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Background="#F7F7F7">
                <ScrollViewer x:Name="TopologyScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="TopologyScrollViewer_PreviewMouseWheel">
                    <Canvas x:Name="Surface" Width="3200" Height="2000" Background="White" AllowDrop="True"
                            DragOver="Surface_TopologyPaletteDragOver"
                            Drop="Surface_TopologyPaletteDrop"
                            MouseMove="Surface_WirePreviewMouseMove">
                        <Canvas.LayoutTransform>
                            <ScaleTransform x:Name="TopologyZoomTransform" ScaleX="1" ScaleY="1" />
                        </Canvas.LayoutTransform>
                    </Canvas>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
